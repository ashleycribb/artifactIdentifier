{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s3a.local/schemas/artifact_manifest.v1.json",
  "title": "S3AArtifactManifest",
  "description": "Schema for S3A centralized research artifact metadata manifests",
  "type": "object",
  "required": ["fingerprint", "classification", "human_override", "attributes"],
  "additionalProperties": false,
  "properties": {
    "fingerprint": {
      "type": "object",
      "required": ["sha256", "file_path", "byte_size", "last_scanned"],
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "file_path": {
          "type": "string"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        },
        "last_scanned": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "classification": {
      "type": "object",
      "required": ["class", "confidence", "source", "rationale"],
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string",
          "enum": [
            "AcademicPaper",
            "AuthorDraft",
            "ResearchNote",
            "ConferencePoster",
            "ConferencePresentation",
            "SourcePackage",
            "NeedsReview"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "source": {
          "type": "string",
          "enum": [
            "deterministic_rule",
            "llm_fallback",
            "human_override"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "human_override": {
      "type": "object",
      "required": ["active", "original_class", "updated_by", "updated_at", "notes"],
      "additionalProperties": false,
      "properties": {
        "active": {
          "type": "boolean"
        },
        "original_class": {
          "type": ["string", "null"]
        },
        "updated_by": {
          "type": ["string", "null"]
        },
        "updated_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "attributes": {
      "type": "object",
      "required": ["title", "authors", "doi", "page_count", "dimensions", "format"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": ["string", "null"]
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "doi": {
          "type": ["string", "null"]
        },
        "page_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "dimensions": {
          "type": ["object", "null"],
          "properties": {
            "width": { "type": "number" },
            "height": { "type": "number" },
            "unit": { "type": "string", "enum": ["in", "mm", "pt"] }
          },
          "required": ["width", "height", "unit"]
        },
        "format": {
          "type": "string"
        }
      }
    }
  }
}
